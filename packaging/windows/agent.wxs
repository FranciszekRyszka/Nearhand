<?xml version="1.0" encoding="utf-8"?>
<!--
  The Nearhand agent for unattended access, as an MSI (WiX 5).

  Installs nearhand-agent.exe to Program Files and registers the Nearhand
  service, as `nearhand-agent install` does. The machine's configuration —
  server, its fingerprint, access password — comes from properties, so the
  same MSI serves a silent rollout (GPO, Intune):

    msiexec /i nearhand-agent.msi /qn SERVER=desk.example.com
            SERVER_FINGERPRINT=<hex> ACCESS_PASSWORD=<password>
            [ENROLL_TOKEN=nhe_...] [DEVICE_NAME=<name>]
            [PASSWORD_WITH_GRANT=1]

  ENROLL_TOKEN, from the server's administrator, adds the machine to the
  server's managed devices; the agent enrolls when the server can be reached.
  People the server grants access then reach the machine, and
  ACCESS_PASSWORD becomes optional: without one, grants are the only way in.

  PASSWORD_WITH_GRANT=1 asks for the access password *as well as* a grant,
  rather than instead of one, so that a server which was taken over cannot
  open the machine on its own. It needs both ACCESS_PASSWORD and
  ENROLL_TOKEN.

  An upgrade or repair on a configured machine needs none of them: the
  configuration and key in %ProgramData%\Nearhand are kept, and so is the ID.
  Uninstalling removes the service and the program, and keeps those too;
  running `nearhand-agent uninstall` with its purge option first removes them.

  Build with build-msi.ps1.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Nearhand Agent"
           Manufacturer="Nearhand"
           Version="$(Version)"
           UpgradeCode="20F1B49E-6D91-4570-9DA2-C6EA4601F377"
           Scope="perMachine"
           Compressed="yes">
    <!-- Same-version upgrades too: a newer build of one version replaces the
         installed one, rather than failing as a conflict. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of the Nearhand agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Set when this machine is configured already: an upgrade or repair
         needs no server or password then. -->
    <Property Id="CONFIGURED">
      <DirectorySearch Id="NearhandData" Path="[CommonAppDataFolder]Nearhand" Depth="0">
        <FileSearch Name="agent.toml" />
      </DirectorySearch>
    </Property>
    <!-- Kept out of the installer's logs: the password, and the command
         line built from it below. -->
    <Property Id="ACCESS_PASSWORD" Hidden="yes" Secure="yes" />
    <Property Id="ENROLL_TOKEN" Hidden="yes" Secure="yes" />
    <Property Id="Configure" Hidden="yes" />
    <Property Id="SERVER" Secure="yes" />
    <Property Id="SERVER_FINGERPRINT" Secure="yes" />
    <Property Id="DEVICE_NAME" Secure="yes" />
    <!-- Ask for the access password as well as a grant from the server,
         rather than instead of one; needs both ACCESS_PASSWORD and
         ENROLL_TOKEN. -->
    <Property Id="PASSWORD_WITH_GRANT" Secure="yes" />

    <Launch Condition="Installed OR CONFIGURED OR (SERVER AND SERVER_FINGERPRINT AND (ACCESS_PASSWORD OR ENROLL_TOKEN))"
            Message="Install with SERVER, SERVER_FINGERPRINT and ACCESS_PASSWORD or ENROLL_TOKEN, for example: msiexec /i nearhand-agent.msi SERVER=desk.example.com SERVER_FINGERPRINT=... ACCESS_PASSWORD=..." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Nearhand">
        <Component Id="Agent" Bitness="always64">
          <File Id="AgentExe" Source="$(AgentExe)" Name="nearhand-agent.exe" KeyPath="yes" />
          <ServiceInstall Id="NearhandService"
                          Name="Nearhand"
                          DisplayName="Nearhand"
                          Description="Lets people with this computer's access password control it remotely, through the Nearhand server it was installed with."
                          Type="ownProcess"
                          Start="auto"
                          ErrorControl="normal"
                          Account="LocalSystem"
                          Arguments="--log &quot;[CommonAppDataFolder]Nearhand\logs\service.log&quot; service">
            <!-- If the service itself fails, Windows starts it again. -->
            <util:ServiceConfig FirstFailureActionType="restart"
                                SecondFailureActionType="restart"
                                ThirdFailureActionType="restart"
                                RestartServiceDelayInSeconds="5"
                                ResetPeriodInDays="1" />
          </ServiceInstall>
          <ServiceControl Id="NearhandService"
                          Name="Nearhand"
                          Start="install"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- `nearhand-agent configure`, as SYSTEM, before the service starts:
         the configuration, the key, the Ctrl+Alt+Del policy, and enrolling
         if there is a token. Only when the properties are given; the command
         line, which holds the password and token, is kept out of the logs.
         Empty ACCESS_PASSWORD, ENROLL_TOKEN and DEVICE_NAME mean none. -->
    <SetProperty Id="WITH_GRANT"
                 Value=" --password-with-grant"
                 Before="SetConfigure"
                 Sequence="execute"
                 Condition="PASSWORD_WITH_GRANT AND ACCESS_PASSWORD AND ENROLL_TOKEN" />
    <SetProperty Id="Configure"
                 Value="&quot;[#AgentExe]&quot; configure --server &quot;[SERVER]&quot; --server-fingerprint &quot;[SERVER_FINGERPRINT]&quot; --password &quot;[ACCESS_PASSWORD]&quot; --token &quot;[ENROLL_TOKEN]&quot; --name &quot;[DEVICE_NAME]&quot;[WITH_GRANT]"
                 Before="Configure"
                 Sequence="execute"
                 Condition="(ACCESS_PASSWORD OR ENROLL_TOKEN) AND NOT REMOVE" />
    <CustomAction Id="Configure"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check"
                  HideTarget="yes" />
    <InstallExecuteSequence>
      <Custom Action="Configure" After="InstallFiles" Condition="(ACCESS_PASSWORD OR ENROLL_TOKEN) AND NOT REMOVE" />
    </InstallExecuteSequence>

    <Feature Id="Main">
      <ComponentRef Id="Agent" />
    </Feature>
  </Package>
</Wix>
