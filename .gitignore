# Planning documents — kept local, not published.
# Deliberately not named `docs/`: this filesystem is case-insensitive and git
# has core.ignorecase=true, so a `Docs/` rule would also swallow the tracked
# `docs/` folder that holds the public documentation.
planning/

# Rust
/target/
**/target/
*.pdb

# Environment / secrets
.env
.env.*
*.pem
*.key
*.crt

# A server's data folder, when run from here: its database.
nearhand.db
nearhand.db-*
nearhand.toml

# Editors / IDEs
.vscode/
.idea/
*.swp

# OS
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# Output of the encode probe
*.h264
